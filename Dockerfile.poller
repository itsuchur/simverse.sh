# syntax=docker/dockerfile:1

FROM oven/bun:1.4.0 AS base
WORKDIR /app

# --- deps ---
# Reuses the same package.json/lockfile as the app, so the cron worker can import
# shared code (db client, types) without a separate package. If its dependency
# footprint diverges a lot from the web app, consider splitting it into its own
# package.json under e.g. /worker instead.
FROM base AS deps
COPY package.json bun.lock* bun.lockb* ./
# postinstall runs `prisma generate`; schema must exist before install, and
# the `prisma` CLI is a devDependency, so this must be a full (non-production)
# install.
COPY prisma ./prisma
RUN bun install --frozen-lockfile

# --- runtime ---
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN groupadd --system --gid 1001 worker \
  && useradd --system --uid 1001 --gid worker worker

COPY --from=deps /app/node_modules ./node_modules
COPY --chown=worker:worker . .
# The Prisma client was generated by the deps stage postinstall; `generated/`
# is not part of the build context (see .dockerignore).
COPY --from=deps --chown=worker:worker /app/generated ./generated

USER worker

CMD ["bun", "--conditions=react-server", "src/server/cron/root.ts"]
