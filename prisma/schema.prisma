// Prisma schema for Better Auth + Telegram Mini App (initData).
// https://better-auth.com/docs/concepts/database
// https://core.telegram.org/bots/webapps#webappinitdata

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  // native = local Mac; linux-arm64 = Docker (Bun on Apple Silicon)
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Better Auth user, extended with Telegram Mini App initData `user` fields.
model User {
  id            String   @id
  /// Display name: initData first_name (+ last_name when present)
  name          String
  /// Better Auth requires email; Mini App users get a synthetic `{telegramId}@telegram.local`
  email         String
  emailVerified Boolean  @default(false)
  /// initData user.photo_url
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  /// initData user.id
  telegramId       String? @unique
  /// initData user.username
  telegramUsername String?
  /// Reserved by better-auth-telegram schema (OIDC); not present in Mini App initData
  telegramPhoneNumber String?
  /// initData user.language_code
  languageCode     String?
  /// initData user.is_premium
  isPremium        Boolean @default(false)
  /// initData user.allows_write_to_pm
  allowsWriteToPm  Boolean @default(false)
  /// First FingerprintJS visitorId collected in the Mini App
  fingerprint      String?
  /// When true, the user cannot add to cart or start checkout
  isBanned         Boolean @default(false)

  sessions Session[]
  accounts Account[]
  orders   Order[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  /// Mirror of initData user.id on the Telegram provider account
  telegramId       String?
  telegramUsername String?

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

/// Purchase / eSIM fulfillment order (snake_case columns in Postgres).
model Order {
  id       BigInt @id @default(autoincrement())
  orderUuid String @default(dbgenerated("gen_random_uuid()")) @map("order_uuid") @db.Uuid

  userId       String  @map("user_id")
  user         User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  initDataHash String? @map("init_data_hash")

  resellerCode    String  @map("reseller_code")
  resellerPlanId  String  @map("reseller_plan_id")
  resellerOrderId String? @map("reseller_order_id")
  packageName     String  @map("package_name")
  countryCode     String? @map("country_code")
  dataAmountMb    Int?    @map("data_amount_mb")
  validityDays    Int     @map("validity_days")

  priceAmount  BigInt  @map("price_amount")
  currency     String  @db.Char(3)
  costAmount   BigInt? @map("cost_amount")
  costCurrency String? @map("cost_currency") @db.Char(3)

  paymentProvider     String  @map("payment_provider")
  paymentChargeId     String? @map("payment_charge_id")
  paymentStatus       String  @default("pending") @map("payment_status")
  paymentRefundId     String? @map("payment_refund_id")
  paymentChargebackId String? @map("payment_chargeback_id")
  refundedAmount      BigInt? @map("refunded_amount")

  status        String  @default("created")
  failureReason String? @map("failure_reason")

  esimIccid           String? @map("esim_iccid")
  esimStatus          String? @map("esim_status")
  esimSmdpStatus      String? @map("esim_smdp_status")
  esimActivationCode  String? @map("esim_activation_code")
  esimQrUrl           String? @map("esim_qr_url")
  esimSmdpAddress     String? @map("esim_smdp_address")
  resellerRawResponse Json?   @map("reseller_raw_response") @db.JsonB

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt    DateTime? @map("paid_at") @db.Timestamptz(6)
  issuedAt  DateTime? @map("issued_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orderUuid], map: "uq_order_uuid")
  @@unique([resellerCode, resellerOrderId], map: "uq_reseller_order")
  @@index([userId], map: "idx_orders_user_id")
  @@index([status], map: "idx_orders_status")
  @@index([resellerCode], map: "idx_orders_reseller_code")
  @@index([createdAt(sort: Desc)], map: "idx_orders_created_at")
  @@index([esimIccid], map: "idx_orders_esim_iccid")
  /// Partial unique index `uq_payment_charge` is defined in the migration SQL
  /// (payment_provider, payment_charge_id) WHERE payment_charge_id IS NOT NULL.
  /// Partial unique index `uq_pending_draft` is defined in the migration SQL
  /// (user_id, payment_provider, reseller_plan_id, price_amount, currency)
  /// WHERE payment_status = 'pending' AND status = 'created'.
  @@map("orders")
}

/// Raw inbound webhook requests for debugging / audit.
model WebhookLog {
  id         BigInt   @id @default(autoincrement())
  source     String
  headers    Json?    @db.JsonB
  payload    Json?    @db.JsonB
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([source], map: "idx_webhook_logs_source")
  /// GIN index `idx_webhook_logs_payload` is defined in the migration SQL.
  @@map("webhook_logs")
}
