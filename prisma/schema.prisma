// Prisma schema for Better Auth + Telegram Mini App (initData).
// https://better-auth.com/docs/concepts/database
// https://core.telegram.org/bots/webapps#webappinitdata

generator client {
  provider      = "prisma-client-js"
  // native = local Mac; linux-arm64 = Docker (Bun on Apple Silicon)
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Better Auth user, extended with Telegram Mini App initData `user` fields.
model User {
  id            String   @id
  /// Display name: initData first_name (+ last_name when present)
  name          String
  /// Better Auth requires email; Mini App users get a synthetic `{telegramId}@telegram.local`
  email         String
  emailVerified Boolean  @default(false)
  /// initData user.photo_url
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  /// initData user.id
  telegramId          String?   @unique
  /// initData user.username
  telegramUsername    String?
  /// Reserved by better-auth-telegram schema (OIDC); not present in Mini App initData
  telegramPhoneNumber String?
  /// initData user.language_code
  languageCode        String?
  /// App UI / Telegram copy locale (`en` | `ru`); set on registration
  preferredLanguage   String?
  /// When false, skip DATA_USAGE / VALIDITY_USAGE Telegram alerts
  dataUsageNotifications Boolean @default(true)
  /// initData user.is_premium
  isPremium           Boolean   @default(false)
  /// initData user.allows_write_to_pm
  allowsWriteToPm     Boolean   @default(false)
  /// First FingerprintJS visitorId collected in the Mini App
  fingerprint         String?
  /// First Mini App open: a `src_*` campaign code, or `organic`
  acquisitionSource   String?
  /// When true, the user cannot add to cart or start checkout
  banReason           String?   @map("ban_reason")
  isBanned            Boolean   @default(false)
  /// Soft delete: user requested account deletion; data purged within a month
  isDeleted           Boolean   @default(false)
  /// When the user requested account deletion
  deletedAt           DateTime?

  sessions Session[]
  accounts Account[]
  orders   Order[]
  requestedRefunds Refund[] @relation("RefundRequester")

  @@unique([email])
  @@map("user")
}

/// Payload from `t.me/<bot>?start=`. That link does not set Mini App `start_param`.
model TelegramStart {
  telegramId   String   @id
  /// First non-payment `/start`: a `src_*` code, or `organic`. Never replaced.
  firstSource  String
  /// Latest `/start`. Cleared once the next Mini App open records it.
  latestSource String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("telegram_start")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  /// Mirror of initData user.id on the Telegram provider account
  telegramId       String?
  telegramUsername String?

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

/// Purchase / eSIM fulfillment order (snake_case columns in Postgres).
model Order {
  id        BigInt @id @default(autoincrement())
  orderUuid String @default(dbgenerated("gen_random_uuid()")) @map("order_uuid") @db.Uuid

  userId       String  @map("user_id")
  user         User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  initDataHash String? @map("init_data_hash")
  /// Revision of the user-global Redis cart used to create this checkout.
  cartRevision String? @map("cart_revision") @db.Uuid
  /// Client IP at draft creation (Cloudflare / Traefik headers).
  buyerIp      String? @map("buyer_ip")

  resellerCode    String  @map("reseller_code")
  resellerPlanId  String  @map("reseller_plan_id")
  resellerOrderId String? @map("reseller_order_id")
  packageName     String  @map("package_name")
  countryCode     String? @map("country_code")
  dataAmountMb    Int?    @map("data_amount_mb")
  validityDays    Int     @map("validity_days")

  priceAmount  BigInt  @map("price_amount")
  currency     String  @db.Char(3)
  costAmount   BigInt? @map("cost_amount")
  costCurrency String? @map("cost_currency") @db.Char(3)

  paymentProvider     String  @map("payment_provider")
  /// Provider checkout link minted for this draft; reused so one draft never has two live invoices.
  paymentInvoiceUrl   String? @map("payment_invoice_url")
  paymentInvoiceId    String? @map("payment_invoice_id")
  paymentNextCheckAt  DateTime @default(now()) @map("payment_next_check_at") @db.Timestamptz(3)
  paymentInvoiceClaim String? @map("payment_invoice_claim") @db.Uuid
  paymentChargeId     String? @map("payment_charge_id")
  paymentStatus       String  @default("pending") @map("payment_status")
  paymentChargebackId String? @map("payment_chargeback_id")
  /// Denormalized completed refund total, updated transactionally with Refund.
  refundedAmount      BigInt? @map("refunded_amount")
  refund              Refund?

  status        String  @default("created")
  failureReason String? @map("failure_reason")

  esimIccid           String? @map("esim_iccid")
  esimStatus          String? @map("esim_status")
  esimSmdpStatus      String? @map("esim_smdp_status")
  esimActivationCode  String? @map("esim_activation_code")
  esimQrUrl           String? @map("esim_qr_url")
  esimSmdpAddress     String? @map("esim_smdp_address")
  /// Provider `activateTime` from a fallback profile query. Write-once.
  firstActivatedAt    DateTime? @map("first_activated_at") @db.Timestamptz(6)
  /// Last successful `totalVolume` / `orderUsage` pair, in bytes.
  dataTotalBytes      BigInt?   @map("data_total_bytes")
  dataUsedBytes       BigInt?   @map("data_used_bytes")
  /// Last parseable provider `expiredTime`. Never cleared on omission.
  expiresAt           DateTime? @map("expires_at") @db.Timestamptz(6)
  /// When the current usage or expiry snapshot was observed.
  usageSyncedAt       DateTime? @map("usage_synced_at") @db.Timestamptz(6)
  /// Set after stored eSIM Access webhooks have been replayed once.
  webhookHistoryAppliedAt DateTime? @map("webhook_history_applied_at") @db.Timestamptz(6)
  /// Set when an activation fallback query completes without throwing.
  activationCheckedAt DateTime? @map("activation_checked_at") @db.Timestamptz(6)
  resellerRawResponse Json?   @map("reseller_raw_response") @db.JsonB

  /// Set when this payment tops up an existing eSIM instead of issuing a new profile.
  topupOfOrderId  BigInt? @map("topup_of_order_id")
  topupOf        Order?  @relation("OrderTopups", fields: [topupOfOrderId], references: [id], onDelete: Restrict)
  topups         Order[] @relation("OrderTopups")
  /// Day-pass extension length. Null for a data top-up package.
  topupPeriodDays Int?    @map("topup_period_days")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt    DateTime? @map("paid_at") @db.Timestamptz(6)
  issuedAt  DateTime? @map("issued_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orderUuid], map: "uq_order_uuid")
  @@unique([resellerCode, resellerOrderId], map: "uq_reseller_order")
  @@index([userId], map: "idx_orders_user_id")
  @@index([status], map: "idx_orders_status")
  @@index([paymentStatus, paymentNextCheckAt], map: "idx_orders_payment_recovery")
  @@index([resellerCode], map: "idx_orders_reseller_code")
  @@index([createdAt(sort: Desc)], map: "idx_orders_created_at")
  @@index([esimIccid], map: "idx_orders_esim_iccid")
  @@index([topupOfOrderId], map: "idx_orders_topup_of_order_id")
  /// Partial unique index `uq_payment_charge` is defined in the migration SQL
  /// (payment_provider, payment_charge_id) WHERE payment_charge_id IS NOT NULL.
  /// Partial unique index `uq_pending_draft` is defined in the migration SQL
  /// for new-plan drafts (topup_of_order_id IS NULL).
  /// Partial unique index `uq_pending_topup_draft` covers top-up drafts.
  @@map("orders")
}

/// One durable full-refund request per order. Retries reuse its idempotency key.
model Refund {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           BigInt   @unique(map: "uq_refunds_order") @map("order_id")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          String
  providerPaymentId String?  @map("provider_payment_id")
  providerRefundId  String?  @map("provider_refund_id")
  idempotencyKey    String   @unique @default(dbgenerated("gen_random_uuid()")) @map("idempotency_key") @db.Uuid
  amount            BigInt
  currency          String   @db.Char(3)
  status            String   @default("requested")
  providerStatus    String?  @map("provider_status")
  reason            String
  source            String
  requestedById     String?  @map("requested_by_id")
  requestedBy       User?    @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  failureCode       String?  @map("failure_code")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)

  @@unique([provider, providerRefundId], map: "uq_refunds_provider_refund")
  @@index([status, createdAt(sort: Desc)], map: "idx_refunds_status_created_at")
  @@index([createdAt(sort: Desc)], map: "idx_refunds_created_at")
  @@map("refunds")
}

/// Sanitized inbound webhook requests for debugging / audit.
model WebhookLog {
  id         BigInt   @id @default(autoincrement())
  source     String
  headers    Json?    @db.JsonB
  payload    Json?    @db.JsonB
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([source], map: "idx_webhook_logs_source")
  /// Partial expression indexes `idx_webhook_logs_esimaccess_iccid` and
  /// `idx_webhook_logs_esimaccess_order_no` are defined in the migration SQL.
  @@map("webhook_logs")
}

/// Dashboard-managed package codes omitted from supplier catalog syncs.
model ExcludedPackageCode {
  id           BigInt   @id @default(autoincrement())
  resellerCode String   @map("reseller_code")
  packageCode  String   @map("package_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([resellerCode, packageCode], map: "uq_excluded_package_codes_reseller_package")
  @@index([resellerCode], map: "idx_excluded_package_codes_reseller_code")
  @@map("excluded_package_codes")
}

/// Dashboard-managed ISO country codes whose single-country packages are omitted from the catalog.
model ExcludedCountryCode {
  id           BigInt   @id @default(autoincrement())
  resellerCode String   @map("reseller_code")
  countryCode  String   @map("country_code")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([resellerCode, countryCode], map: "uq_excluded_country_codes_reseller_country")
  @@index([resellerCode], map: "idx_excluded_country_codes_reseller_code")
  @@map("excluded_country_codes")
}
