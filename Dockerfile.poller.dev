# syntax=docker/dockerfile:1

FROM oven/bun:1.4.3
WORKDIR /app

COPY package.json bun.lock* bun.lockb* ./
# postinstall runs `prisma generate`; schema must exist before install.
COPY prisma ./prisma
RUN bun install --frozen-lockfile

# Source is bind-mounted at runtime; keep a copy so the image is usable alone.
COPY . .

ENV NODE_ENV=development
# Default catalog price multiplier; seeded into Redis via SETNX (dashboard can override).
ENV PRICE_MODIFIER=1

CMD ["bun", "--conditions=react-server", "--watch", "src/server/cron/root.ts"]
