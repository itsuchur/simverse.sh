# syntax=docker/dockerfile:1
# Bun binary is glibc; use Debian Node so `COPY --from=oven/bun` actually runs.
# Keep Debian mirrors on HTTP. node:*-slim has no CA bundle, so apt over HTTPS
# fails the handshake. Archive signatures still authenticate the indexes.
#
# Docker Hub node:22.23.4-* tags were empty stubs (no linux/amd64) on 2026-10-21.
# Use the last good bookworm-slim base and overlay Node 22.23.4 from nodejs.org.

FROM oven/bun:1.4.4 AS bun

FROM node:22.23.3-bookworm-slim
ARG NODE_VERSION=22.23.4
RUN set -eux; \
  printf 'Acquire::Retries "5";\nAcquire::http::Timeout "120";\nAcquire::https::Timeout "120";\n' > /etc/apt/apt.conf.d/80-retries; \
  for attempt in 1 2 3 4 5; do \
    if apt-get update \
      && apt-get install -y --no-install-recommends ca-certificates curl xz-utils git python3 make g++ gosu; then break; fi; \
    if [ "$attempt" = "5" ]; then exit 1; fi; \
    sleep $((attempt * 5)); \
  done; \
  arch="$(dpkg --print-architecture)"; \
  case "$arch" in \
    amd64) node_arch=x64 ;; \
    arm64) node_arch=arm64 ;; \
    *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
  esac; \
  curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1; \
  node --version; \
  npm --version; \
  apt-get purge -y --auto-remove curl xz-utils; \
  rm -rf /var/lib/apt/lists/*
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /opt/
COPY package.json bun.lock ./
COPY patches ./patches
RUN --mount=type=cache,id=simverse-bun,target=/root/.bun/install/cache \
    bun install --frozen-lockfile
ENV PATH=/opt/node_modules/.bin:$PATH

WORKDIR /opt/app
COPY . .
COPY docker-entrypoint.sh /usr/local/bin/strapi-entrypoint.sh
RUN chmod +x /usr/local/bin/strapi-entrypoint.sh \
  && mkdir -p /opt/app/public/uploads \
  && chown -R node:node /opt/app
ENTRYPOINT ["strapi-entrypoint.sh"]
EXPOSE 1337
CMD ["npm", "run", "develop"]
