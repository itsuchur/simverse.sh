# syntax=docker/dockerfile:1

FROM oven/bun:1.4.2
WORKDIR /app

COPY package.json bun.lock* bun.lockb* ./
# postinstall runs `prisma generate`; schema must exist before install.
COPY prisma ./prisma
RUN bun install --frozen-lockfile

# Source is bind-mounted at runtime; keep a copy so the image is usable alone.
COPY . .

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
# Reliable file watching with bind mounts (esp. Docker Desktop on macOS)
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["bun", "run", "dev"]
