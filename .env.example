# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""
# Public app URL (auth callbacks, trusted origin). Use your ngrok host in local/Telegram Mini App testing.
BETTER_AUTH_URL=https://magical-guinea-utterly.ngrok-free.app

# Telegram Mini App (Better Auth)
TELEGRAM_BOT_TOKEN="123456789:AA...."
TELEGRAM_BOT_USERNAME="simversedevbot"

# Prisma / Postgres
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Local: postgresql://postgres:postgres@localhost:5432/app
# Docker Compose: use the postgres service host (as below).
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="app"
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/app"

# Redis
# Local: redis://:password@localhost:6379
# Docker Compose: use the redis service host (as below).
REDIS_PASSWORD="redis"
REDIS_URL="redis://:redis@redis:6379"

# eSIM Access
# https://console.esimaccess.com/developer/index
ESIMACCESS_ACCESS_CODE=""
# Random secret (>= 16 chars, e.g. `openssl rand -hex 24`) embedded in the
# webhook URL registered with eSIM Access:
#   https://<APP_DOMAIN>/api/webhooks/suppliers/esimaccess?token=<secret>
ESIMACCESS_WEBHOOK_SECRET=""
