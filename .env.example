# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""
# Dashboard origin (Google OAuth baseURL / trusted origin). No trailing slash.
# Local Mini App / ngrok: use the tunnel host. Production: https://dashboard.simverse.sh
BETTER_AUTH_URL=https://magical-guinea-utterly.ngrok-free.app
# Production public hosts (omit locally; they fall back to BETTER_AUTH_URL).
# MINIAPP_URL=https://miniapp.simverse.sh
# API_URL=https://api.simverse.sh

# Telegram Mini App (Better Auth)
TELEGRAM_BOT_TOKEN="123456789:AA...."
TELEGRAM_BOT_USERNAME="simversedevbot"
# Shared secret Telegram sends as X-Telegram-Bot-Api-Secret-Token on every bot
# update. Required in production (>= 16 chars; only A-Z a-z 0-9 _ -).
# Generate: openssl rand -hex 24
# Register (same value as this env var):
#   curl -sS "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#     -d "url=https://api.simverse.sh/webhooks/telegram" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>" \
#     -d 'allowed_updates=["message","pre_checkout_query"]'
TELEGRAM_WEBHOOK_SECRET="0123456789abcdef0123456789abcdef"

# Prisma / Postgres
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Local: postgresql://postgres:postgres@localhost:5432/app
# Docker Compose: use the postgres service host (as below).
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="app"
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/app"

# Redis
# Local: redis://:password@localhost:6379
# Docker Compose: use the redis service host (as below).
REDIS_PASSWORD="redis"
REDIS_URL="redis://:redis@redis:6379"

# eSIM Access
# https://console.esimaccess.com/developer/index
ESIMACCESS_ACCESS_CODE=""
# Random secret (>= 16 chars, e.g. `openssl rand -hex 24`) embedded in the
# webhook URL registered with eSIM Access:
#   https://api.simverse.sh/webhooks/suppliers/esimaccess?token=<secret>
ESIMACCESS_WEBHOOK_SECRET=""

# Trybit merchant API (https://docs.trybit.com/api-reference-v2/create-invoice)
# Set the project notification URL to https://api.simverse.sh/webhooks/payments/trybit (JSON)
TRYBIT_API_KEY=""
TRYBIT_SHOP_ID=""
TRYBIT_SECRET_KEY=""

# Cardlink merchant API (https://cardlink.link/en/reference/api#bill-create)
# Shop Result URL: https://api.simverse.sh/webhooks/payments/cardlink
# Shop Refund URL: https://api.simverse.sh/webhooks/payments/cardlink/refund
# Shop Chargeback URL: https://api.simverse.sh/webhooks/payments/cardlink/chargeback
CARDLINK_API_TOKEN=""
CARDLINK_SHOP_ID=""

# Google OAuth (internal dashboard). Authorized redirect URI:
#   {BETTER_AUTH_URL}/api/auth/callback/google
# Production: https://dashboard.simverse.sh/api/auth/callback/google
# Only support@simverse.sh is allowed to access the dashboard.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# TonConsole.com API
TONCONSOLE_KEY=""

# OpenRouter API key
OPENROUTER_KEY="sk-or-v1-"

# PostHog (optional; omit the key to disable analytics)
# Host is the ingest origin, not the marketing site. EU cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_your_actual_public_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
